<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/homeBgA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home_gradient_1"
        android:contentDescription="@null"/>

    <ImageView
        android:id="@+id/homeBgB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/homeAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/homeDefaultPlaylist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"/>

        <!-- Кнопки в столбик на портрете — иначе на узком экране
             две квадратные кнопки 200dp + 32dp gap не помещаются. -->
        <LinearLayout
            android:id="@+id/btnHomeLive"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_home_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_play"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/home_live"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_live"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHomePlaylists"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_home_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_playlist"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/playlists"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlists"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
