<?xml version="1.0" encoding="utf-8"?>
<!-- Round 180: Settings — не отдельное окно, а боковая панель справа на
     половину экрана. Полупрозрачный затемняющий фон поверх MainActivity
     (видно сквозь Activity с translucent theme), клик по нему закрывает
     Settings; сам контент в правой панели, тоже полупрозрачный. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Затемнение поверх MainActivity (тап → закрыть Settings).
         id используется в SettingsActivity для onClickListener. -->
    <View
        android:id="@+id/settingsDimBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="false"/>

    <!-- Сама боковая панель: справа, 50% ширины, во весь рост,
         полупрозрачный тёмно-фиолетовый фон чтобы было ощущение
         "панель", а не сплошное окно. -->
    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E62A2A48"/>

</FrameLayout>
