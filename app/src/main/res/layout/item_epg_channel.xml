<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:focusable="true"
    android:foreground="@drawable/item_channel_focused"
    android:background="@drawable/bg_epg_row">

    <ImageView
        android:id="@+id/epgChannelLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_channel_placeholder"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/epgChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/epgNowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>

        <ProgressBar
            android:id="@+id/epgNowProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="#33FFFFFF"
            android:max="100"
            android:layout_marginTop="3dp"
            android:visibility="gone"/>

    </LinearLayout>

    <TextView
        android:id="@+id/epgNowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"/>

    <!-- Невидимые холдеры — Adapter ссылается на них по ID, но в новом
         компактном layout они скрыты. Оставлены ради совместимости с
         существующим EpgAdapter (LIVE-бейдж убран по запросу). -->
    <TextView
        android:id="@+id/epgLiveBadge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/epgNowLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/epgNextLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
