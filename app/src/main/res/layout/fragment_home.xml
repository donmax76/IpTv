<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Два слоя фона для cross-fade анимации каждые ~8 сек.
         HomeFragment попеременно меняет background у homeBgA / homeBgB
         и анимирует alpha между ними — без двойной нагрузки на GPU. -->
    <ImageView
        android:id="@+id/homeBgA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home_gradient_1"
        android:contentDescription="@null"/>

    <ImageView
        android:id="@+id/homeBgB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null"/>

    <!-- Затемняющий слой для контраста кнопок поверх ярких градиентов -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"/>

    <!-- Индикатор загрузки плейлиста при клике "Прямой эфир".
         Скрыт по умолчанию, показывается на время fetchPlaylist. -->
    <ProgressBar
        android:id="@+id/homeLiveProgress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/homeAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/homeDefaultPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btnHomeLive"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginEnd="32dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_home_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_play"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="@string/home_live"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_live"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHomePlaylists"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_home_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_playlist"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="@string/playlists"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playlists"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
