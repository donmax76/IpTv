<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false"/>

    <!-- Persistent clock (always visible, even when controls are hidden) -->
    <TextView
        android:id="@+id/persistentClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#80000000"
        android:visibility="gone"/>

    <!-- Custom overlay controls -->
    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_player_gradient_top"
            android:layout_alignParentTop="true">

            <!-- Стрелка "Назад" скрыта по запросу пользователя.
                 Выход из плеера: BACK на пульте или DPAD_LEFT 2x. -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                android:contentDescription="@string/back"/>

            <!-- Touch-кнопка: открыть список каналов. На пульте то же
                 самое делает DPAD_LEFT, на телефоне — нажатие сюда. -->
            <ImageButton
                android:id="@+id/btnTouchChannelList"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_channels"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/channels"
                android:padding="6dp"
                android:focusable="false"
                android:tint="@android:color/white"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/channelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/epgNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Clock display -->
            <TextView
                android:id="@+id/clockDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_live_badge"
                android:layout_marginEnd="6dp"/>

            <!-- Разрешение перенесено в нижнюю инфо-панель
                 (см. bottomInfoBar внизу controlsOverlay). -->

            <!-- Audio track info (shows track count) -->
            <TextView
                android:id="@+id/audioTrackInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:visibility="gone"/>

            <!-- Кнопки настроек плеера (аудио/скорость/PiP/блокировка/
                 соотношение/список каналов) перенесены в правое
                 выпадающее меню (DPAD_RIGHT). Здесь они скрыты, но
                 оставлены ради существующих ссылок в Kotlin-коде —
                 проще скрыть, чем переписывать инициализацию. -->
            <ImageButton
                android:id="@+id/btnAudioTrack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_audio_track"
                android:visibility="gone"
                android:contentDescription="@string/audio_track"/>

            <ImageButton
                android:id="@+id/btnSpeed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_speed"
                android:visibility="gone"
                android:contentDescription="@string/playback_speed"/>

            <ImageButton
                android:id="@+id/btnChannelList"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_channel_list"
                android:visibility="gone"
                android:contentDescription="@string/channel_list"/>

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_lock"
                android:visibility="gone"
                android:contentDescription="@string/screen_lock"/>

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_pip"
                android:visibility="gone"
                android:contentDescription="PiP"/>

            <ImageButton
                android:id="@+id/btnAspectRatio"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_aspect_ratio"
                android:visibility="gone"
                android:contentDescription="@string/aspect_ratio"/>

            <!-- Touch-кнопка: открыть правое меню плеера (Аудио, Скорость,
                 PiP, Блокировка, Соотношение сторон). На пульте то же
                 самое делает DPAD_RIGHT. -->
            <ImageButton
                android:id="@+id/btnTouchRightMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_menu"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="6dp"
                android:focusable="false"
                android:tint="@android:color/white"/>

        </LinearLayout>

        <!-- Кнопки спрятаны: пользователь не хочет видеть посередине
             экрана кнопку паузы, а внизу — номер канала и стрелки
             prev/next. Сама пауза по-прежнему доступна через тап
             экрана и MEDIA_PLAY_PAUSE на пульте, переключение каналов
             — через UP/DOWN/CHANNEL+/-/PAGE+/-. Кнопки оставлены в
             разметке (visibility=gone) ради ID-ссылок в коде. -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_pause"
            android:visibility="gone"
            android:contentDescription="@string/play_pause"/>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_player_gradient_bottom"
            android:layout_alignParentBottom="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/sleepTimerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_orange"
                android:textSize="11sp"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnPrevChannel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/prev_channel"/>

            <TextView
                android:id="@+id/channelNumber"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnNextChannel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/next_channel"/>

        </LinearLayout>

    </RelativeLayout>

    <!-- Semi-transparent channel list overlay panel (OTT Navigator style) -->
    <FrameLayout
        android:id="@+id/channelListOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Dim background (clickable to close) -->
        <View
            android:id="@+id/channelListDimBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#60000000"/>

        <!-- Контейнер: вертикальный столбец категорий (слева) +
             панель списка каналов (справа). Если у плейлиста нет
             категорий — overlayCategoriesPanel скрывается, остаётся
             только список каналов 320dp шириной. -->
        <LinearLayout
            android:id="@+id/channelListPanel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="horizontal">

            <!-- Вертикальный столбец категорий. Появляется слева от
                 списка каналов когда они есть. На пульте: 2-е нажатие
                 DPAD_LEFT (после открытия списка каналов) перемещает
                 фокус сюда. 3-е нажатие открывает боковое меню плеера.
                 Если у плейлиста нет категорий — visibility=gone. -->
            <LinearLayout
                android:id="@+id/overlayCategoriesPanel"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_overlay_panel"
                android:paddingTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/category"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/overlayCategoriesList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="12dp"/>

            </LinearLayout>

            <!-- Список каналов. Раньше был LinearLayout, теперь
                 содержит только заголовок + поиск + сам список.
                 Скрывается на 2-м DPAD_LEFT когда показываем категории. -->
            <LinearLayout
                android:id="@+id/overlayChannelsPanel"
                android:layout_width="720dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_overlay_panel"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="6dp">

                    <!-- Имя плейлиста. Заполняется из prefs.lastPlaylistName
                         в коде. Если пусто — показываем "Каналы". -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Round 213: тач-кнопка «меню» слева — открывает
                             центральное popup-меню (фото 4 SS IPTV). На пульте
                             то же самое делает 3-е DPAD_LEFT. На телефоне
                             без неё юзер не мог попасть в меню. -->
                        <ImageButton
                            android:id="@+id/btnTouchOpenMenu"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_menu"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#FF09B8E5"
                            android:padding="6dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/settings"
                            android:focusable="false"/>

                        <!-- Round 213: тач-кнопка категорий — открывает
                             панель категорий. На пульте — 2-е DPAD_LEFT. -->
                        <ImageButton
                            android:id="@+id/btnTouchOpenCategories"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_channels"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#FF09B8E5"
                            android:padding="6dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/category"
                            android:focusable="false"/>

                        <TextView
                            android:id="@+id/overlayPlaylistName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/channels"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/overlayChannelCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0CC"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <!-- Выбранная категория. Показывается только когда
                         выбрана конкретная (не "Все"). -->
                    <TextView
                        android:id="@+id/overlaySelectedCategoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7C6CF7"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- Search in channel list -->
                <EditText
                    android:id="@+id/overlaySearchEdit"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_overlay_search"
                    android:hint="@string/search_channels"
                    android:textColor="@android:color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="text"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/overlayChannelsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:descendantFocusability="afterDescendants"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Inline-панель деталей канала (продолжение списка вправо).
             Показывается из OverlayChannelAdapter onShowDetailsClick.
             BACK или DPAD_LEFT — закрывает её, фокус возвращается на
             "избранное" чтобы юзер мог снова нажать вправо. -->
        <ScrollView
            android:id="@+id/channelDetailsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="720dp"
            android:background="@drawable/bg_overlay_panel"
            android:padding="16dp"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailsChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/detailsNowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#7C6CF7"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:text="@string/now_playing_label"/>

                <TextView
                    android:id="@+id/detailsNowTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B0B0C0"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/detailsNowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/detailsNowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D0D0E0"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#33FFFFFF"/>

                <TextView
                    android:id="@+id/detailsNextLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4ECDC4"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:text="@string/up_next_label"/>

                <TextView
                    android:id="@+id/detailsNextTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B0B0C0"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/detailsNextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/detailsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#707088"
                    android:textSize="12sp"
                    android:layout_marginTop="20dp"
                    android:text="@string/hint_close_with_back"/>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Round 211: ЦЕНТРАЛЬНОЕ popup-меню в стиле SS IPTV (фото 4).
         Показывается на 3-е нажатие DPAD_LEFT. Полупрозрачный
         тёмно-синий фон с закруглёнными углами и cyan-рамкой, пункты
         с иконками подсвечиваются ярким голубым градиентом при
         фокусе. Анимация scale-in при появлении. -->
    <!-- Round 221a: elevation=24dp + focusable панель, чтобы система
         гарантированно ставила это поверх каналов и категорий. -->
    <FrameLayout
        android:id="@+id/playerCenterMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="24dp"
        android:visibility="gone">

        <View
            android:id="@+id/playerCenterMenuDimBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A0000000"
            android:clickable="true"
            android:focusable="false"/>

        <LinearLayout
            android:id="@+id/playerCenterMenuPanel"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_center_menu_panel"
            android:padding="24dp"
            android:descendantFocusability="afterDescendants">

            <!-- Текущий плейлист — крупная подсветка как в SS IPTV -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF09B8E5"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:text="@string/playlists"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/centerMenuPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_center_menu_item"
                android:padding="14dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_marginBottom="16dp"/>

            <!-- Round 221a: заменил MaterialButton → Button. MaterialButton
                 рисует свой собственный фон поверх android:background, из-за
                 чего cyan-подсветка фокуса из bg_center_menu_item не была
                 видна — юзер думал что меню «не отвечает». -->
            <Button
                android:id="@+id/centerMenuSettings"
                style="@style/CenterMenuItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/settings"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="14dp"
                android:drawableTint="#FFB0E0F0"/>

            <Button
                android:id="@+id/centerMenuFavorites"
                style="@style/CenterMenuItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/favorites"
                android:drawableStart="@drawable/ic_favorite"
                android:drawablePadding="14dp"
                android:drawableTint="#FFB0E0F0"/>

            <Button
                android:id="@+id/centerMenuRecent"
                style="@style/CenterMenuItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/recent"
                android:drawableStart="@drawable/ic_recent"
                android:drawablePadding="14dp"
                android:drawableTint="#FFB0E0F0"/>

            <Button
                android:id="@+id/centerMenuSearch"
                style="@style/CenterMenuItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/search_channels"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="14dp"
                android:drawableTint="#FFB0E0F0"/>

        </LinearLayout>

    </FrameLayout>

    <!-- Side drawer that slides in from the left edge when the user
         presses LEFT a second time inside the channel list overlay.
         Lives in PlayerActivity itself so it appears ON TOP of the
         channel list without finishing the player. -->
    <FrameLayout
        android:id="@+id/playerDrawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/playerDrawerDimBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"/>

        <LinearLayout
            android:id="@+id/playerDrawerPanel"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerDrawerPlaylists"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/playlists"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_playlist"/>

            <!-- playerDrawerChannels удалён: вкладка Каналы убрана из
                 навигации, список каналов доступен через DPAD_LEFT
                 в плеере (или кнопка ≡ слева в верхней панели). -->

            <!-- ТВ Гид удалён по просьбе пользователя — программа
                 показывается прямо в списке каналов. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerDrawerFavorites"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/favorites"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_favorite"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerDrawerRecent"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/recent"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_recent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playerDrawerSettings"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_settings"/>

        </LinearLayout>

    </FrameLayout>

    <!-- Правое выпадающее меню плеера: открывается по DPAD_RIGHT.
         Содержит все настройки, которые раньше торчали в верхнем
         правом углу (Аудио / Скорость / Список каналов / Блокировка /
         PiP / Соотношение). Закрывается по DPAD_LEFT, BACK или
         тапу по затемнению. -->
    <FrameLayout
        android:id="@+id/playerRightMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/playerRightMenuDimBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"/>

        <LinearLayout
            android:id="@+id/playerRightMenuPanel"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuFavorite"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/favorite"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_favorite"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuChannelList"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/channel_list"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_channel_list"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuLastChannel"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/last_channel"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_recent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuAudio"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/audio_track"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_audio_track"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuSpeed"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/playback_speed"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_speed"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuAspect"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/aspect_ratio"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_aspect_ratio"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuPip"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="PiP"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_pip"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuLock"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/screen_lock"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_lock"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rightMenuHttp"
                style="@style/PlayerDrawerItem"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/channel_http_headers"
                android:textColor="@color/text_primary"
                android:focusable="true"
                app:icon="@drawable/ic_settings"/>

        </LinearLayout>

    </FrameLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"/>

    <!-- Error overlay -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_playback"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:backgroundTint="@color/primary"/>

    </LinearLayout>

    <!-- Channel info banner OSD (appears on channel switch - OTT Navigator style) -->
    <LinearLayout
        android:id="@+id/channelInfoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_panel"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bannerChannelNumber"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_channel_number"/>

            <ImageView
                android:id="@+id/bannerChannelLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/bannerChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/bannerEpgNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Разрешение текущего потока (1080p / 720p / 4K).
                 Заполняется из onVideoSizeChanged когда плеер
                 узнаёт реальный размер кадра. -->
            <TextView
                android:id="@+id/bannerResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_live_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/bannerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- EPG progress bar -->
        <ProgressBar
            android:id="@+id/bannerEpgProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="#40FFFFFF"
            android:max="100"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/bannerEpgNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Gesture indicator (volume/brightness) -->
    <LinearLayout
        android:id="@+id/gestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_gesture_indicator"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gestureIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:tint="@android:color/white"/>

        <ProgressBar
            android:id="@+id/gestureProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="#40FFFFFF"
            android:max="100"/>

        <TextView
            android:id="@+id/gestureText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Screen lock overlay -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnUnlock"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock_open"
            android:background="@drawable/bg_player_control"
            android:scaleType="center"
            android:visibility="gone"
            android:contentDescription="@string/screen_unlock"/>

    </FrameLayout>

    <!-- Channel number input overlay (for remote number input) -->
    <TextView
        android:id="@+id/numberInputDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:background="#99000000"
        android:padding="16dp"
        android:visibility="gone"/>

</FrameLayout>
