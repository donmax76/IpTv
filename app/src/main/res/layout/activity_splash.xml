<?xml version="1.0" encoding="utf-8"?>
<!-- Round 222c/227: контент-сплеш. По дефолту тема прозрачная, окна
     нет; SplashActivity вызывает setContentView только когда юзер
     согласился обновиться, и тогда виден лого + полоса прогресса
     загрузки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_playlist"
        android:tint="@color/primary"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/app_name"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/splashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="28dp"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="#30FFFFFF"
        android:visibility="gone"/>

</LinearLayout>
