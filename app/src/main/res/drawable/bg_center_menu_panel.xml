<?xml version="1.0" encoding="utf-8"?>
<!-- Round 211: фон центрального popup-меню. Тёмно-синий градиент с
     закруглёнными углами и тонкой голубой рамкой — стиль SS IPTV. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#F01E1E3A"
        android:centerColor="#F02A2A52"
        android:endColor="#F01A1A36"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1.5dp"
        android:color="#5009B8E5" />
    <padding
        android:left="20dp"
        android:right="20dp"
        android:top="20dp"
        android:bottom="20dp" />
</shape>
