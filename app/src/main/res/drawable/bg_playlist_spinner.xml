<?xml version="1.0" encoding="utf-8"?>
<!-- Round 222: фон для спиннера встроенных плейлистов. Подсвечивает
     фокус — без этого юзер не видел на каком из 4 комбобоксов сейчас
     стоит D-pad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E3E72"/>
            <stroke android:width="2dp" android:color="@color/primary"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E3E72"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E2E52"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
