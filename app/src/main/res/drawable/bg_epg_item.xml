<?xml version="1.0" encoding="utf-8"?>
<!-- Round 218: дефолтное состояние теперь полупрозрачное (~38% alpha)
     чтобы видео нормально просвечивало через строки канала. Раньше был
     сплошной #1A1A2E (100% непрозрачный) — поверх прозрачной панели
     видео всё равно не было видно. Фокус оставлен почти непрозрачным
     (CC = 80%) чтобы выделенный канал был ярко виден. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#CC7C6CF7"/>
            <corners android:radius="8dp"/>
            <stroke android:width="2dp" android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#806C5CE7"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#606C5CE7"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#806C5CE7"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#601A1A2E"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
