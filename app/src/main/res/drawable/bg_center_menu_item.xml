<?xml version="1.0" encoding="utf-8"?>
<!-- Round 211: фон пункта центрального меню. Прозрачный когда не в фокусе,
     яркий cyan-голубой градиент когда сфокусирован (как в SS IPTV). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FF09B8E5"
                android:endColor="#FF0080C8"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF00D4FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF09B8E5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
