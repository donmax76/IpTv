<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2C003E"
                android:centerColor="#512B81"
                android:endColor="#8E05C2"
                android:angle="225"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#90FF61D2"
                android:endColor="#00FF61D2"
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.15"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#9000C2FF"
                android:endColor="#0000C2FF"
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.1"
                android:centerY="0.85"/>
        </shape>
    </item>
</layer-list>
