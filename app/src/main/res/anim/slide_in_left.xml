<?xml version="1.0" encoding="utf-8"?>
<!-- Round 211: slide-in from LEFT edge (200 ms, ease-out). Используется
     для левосторонних оверлеев — channelListOverlay, playerDrawerOverlay. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate
        android:fromXDelta="-100%p"
        android:toXDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
