<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:background="#FF050508"
    android:padding="6dp">

    <!-- ======== LEFT SIDE: Radio Controls + Volume Bar ======== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="4dp">

        <!-- ======== Radio Controls Panel ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_car_radio"
            android:padding="10dp">

            <!-- Top bar: Status + indicators + version -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/tvVersion"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btnDebug"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_toStartOf="@+id/tvVersion"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:text="DBG"
                    android:textColor="#FF888800"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal"
                    android:padding="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/btnExit"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:text="v3.0"
                    android:textColor="@color/version_text"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btnExit"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="✕"
                    android:textColor="#FFFF4444"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_metal"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </RelativeLayout>

            <!-- ========= LCD DISPLAY ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_lcd_display"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <!-- LCD top row: Band + Stereo + RDS + TA + AF + Signal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBandIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FM"
                        android:textColor="@color/lcd_amber"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvStereoIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEREO"
                        android:textColor="@color/lcd_dim"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:id="@+id/tvRdsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDS"
                        android:textColor="@color/lcd_dim"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:id="@+id/tvTaIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TA"
                        android:textColor="@color/lcd_dim"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginStart="14dp" />

                    <TextView
                        android:id="@+id/tvAfIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AF"
                        android:textColor="@color/lcd_dim"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginStart="14dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSignalBars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▁   "
                        android:textColor="@color/lcd_dim"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Big frequency display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvFrequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100.0"
                        android:textColor="@color/lcd_green"
                        android:textSize="48sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:shadowColor="@color/glow_green_strong"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="20" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp"
                        android:gravity="start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MHz"
                            android:textColor="@color/lcd_amber"
                            android:textSize="20sp"
                            android:fontFamily="monospace" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Station name: shows RDS PS if available, else user-entered name -->
                <TextView
                    android:id="@+id/tvStationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lcd_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:shadowColor="@color/glow_cyan"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />

                <!-- Hidden, used internally for RDS PS storage -->
                <TextView
                    android:id="@+id/tvRdsPs"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- RDS RadioText + PTY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvRdsRt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/lcd_amber"
                        android:textSize="16sp"
                        android:fontFamily="monospace"
                        android:maxLines="3"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRdsPty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lcd_cyan"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:layout_marginStart="10dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Frequency scale bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvBandStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88"
                        android:textColor="@color/lcd_dim"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />

                    <SeekBar
                        android:id="@+id/seekFrequency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:minHeight="32dp"
                        android:progressTint="@color/lcd_green"
                        android:thumbTint="@color/lcd_green"
                        android:progressBackgroundTint="@color/lcd_dim" />

                    <TextView
                        android:id="@+id/tvBandEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="108"
                        android:textColor="@color/lcd_dim"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========= MAIN CONTROLS ROW ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp">

                <ImageButton
                    android:id="@+id/btnSeekBack"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_seek_back"
                    android:background="@drawable/bg_seek_button"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_seek_back" />

                <ImageButton
                    android:id="@+id/btnFreqDown"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="@drawable/bg_button_metal"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_freq_down"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/btnPlayStop"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_button_play"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:contentDescription="@string/cd_play_stop"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp" />

                <ImageButton
                    android:id="@+id/btnFreqUp"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="@drawable/bg_button_metal"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_freq_up"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnSeekForward"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_seek_forward"
                    android:background="@drawable/bg_seek_button"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_seek_forward" />
            </LinearLayout>

            <!-- Function buttons: SCAN | AF | TA | PTY | BAND -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="SCAN"
                    android:textColor="@color/lcd_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnAf"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="AF"
                    android:textColor="@color/lcd_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnTa"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="TA"
                    android:textColor="@color/lcd_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnPty"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="PTY"
                    android:textColor="@color/lcd_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnBand"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="2"
                    android:text="BAND: FM"
                    android:textColor="@color/lcd_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_button_metal" />
            </LinearLayout>

            <!-- ========= Volume + EQ (moved inside main panel) ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

            <!-- Volume -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOL"
                android:textColor="@color/lcd_amber"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:progressTint="@color/lcd_amber"
                android:thumbTint="@color/lcd_amber"
                android:progressBackgroundTint="@color/lcd_dim" />

            <TextView
                android:id="@+id/tvVolumeValue"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="80"
                android:textColor="@color/lcd_amber"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="end" />

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/lcd_dim"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <!-- Bass -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BASS"
                android:textColor="@color/lcd_cyan"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="20"
                android:progress="10"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:progressTint="@color/lcd_cyan"
                android:thumbTint="@color/lcd_cyan"
                android:progressBackgroundTint="@color/lcd_dim" />

            <TextView
                android:id="@+id/tvBassValue"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/lcd_cyan"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="end" />

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/lcd_dim"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <!-- Treble -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TREB"
                android:textColor="@color/lcd_cyan"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekTreble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:max="20"
                android:progress="10"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:progressTint="@color/lcd_cyan"
                android:thumbTint="@color/lcd_cyan"
                android:progressBackgroundTint="@color/lcd_dim" />

            <TextView
                android:id="@+id/tvTrebleValue"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/lcd_cyan"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="end" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======== DEBUG LOG PANEL (hidden by default) ======== -->
    <LinearLayout
        android:id="@+id/layoutDebug"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FF0A0A12"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEBUG LOG"
                android:textColor="#FF00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnDebugSave"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="SAVE"
                android:textColor="#FF00CCFF"
                android:textSize="11sp"
                android:background="@drawable/bg_button_metal"
                android:layout_marginEnd="4dp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnDebugClear"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="CLEAR"
                android:textColor="#FFFF6600"
                android:textSize="11sp"
                android:background="@drawable/bg_button_metal"
                android:layout_marginEnd="4dp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnDebugClose"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="CLOSE"
                android:textColor="#FFFF4444"
                android:textSize="11sp"
                android:background="@drawable/bg_button_metal"
                android:padding="4dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollDebug"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF00CC00"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="-1dp"
                android:text=""
                android:gravity="bottom" />
        </ScrollView>
    </LinearLayout>

    <!-- ======== RIGHT PANEL: Stations only (full height) ======== -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_car_radio"
        android:padding="8dp"
        android:layout_marginStart="4dp">

        <!-- ======= STATIONS SECTION ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvStationsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STATIONS ▼"
                android:textColor="@color/lcd_amber"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/btnAddStation"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="+"
                android:textColor="@color/lcd_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_button_metal"
                android:clickable="true"
                android:focusable="true"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Scan progress (hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutScanning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="4dp">

            <ProgressBar
                android:id="@+id/progressScan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/lcd_green" />

            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center" />
        </LinearLayout>

        <!-- Station list (takes all remaining space, extra bottom padding for car nav bar) -->
        <ListView
            android:id="@+id/lvStations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="60dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="2dp"
            android:scrollbarThumbVertical="@color/lcd_dim" />
    </LinearLayout>

</LinearLayout>
